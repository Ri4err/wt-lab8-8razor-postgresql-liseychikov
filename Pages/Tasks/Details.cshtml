@page "{id:int}"
@model wt_lab8_8razor_postgresql_liseychikov.Pages.Tasks.DetailsModel
@{
    ViewData["Title"] = "Детали задачи";
}

<div class="container mt-4">
    <h1 class="mb-4">Детали задачи</h1>

    @if (Model.Task != null)
    {
        <div class="card shadow rounded p-4" style="max-width: 600px;">
            <dl class="row mb-0">
                <dt class="col-sm-4">ID</dt>
                <dd class="col-sm-8">@Model.Task.Id</dd>

                <dt class="col-sm-4">Название</dt>
                <dd class="col-sm-8">@Model.Task.Name</dd>

                <dt class="col-sm-4">Категория</dt>
                <dd class="col-sm-8">@Model.Task.Category</dd>

                <dt class="col-sm-4">Цена</dt>
                <dd class="col-sm-8">@Model.Task.Price</dd>

                <dt class="col-sm-4">Доступна</dt>
                <dd class="col-sm-8">@(Model.Task.IsAvaliable ? "Да" : "Нет")</dd>
            </dl>
        </div>
    }

    <div class="mt-3">
        <a asp-page="Index" class="btn btn-secondary">Назад к списку</a>
    </div>
</div>